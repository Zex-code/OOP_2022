import turtle
import time
turtle.shape('turtle')
n=10
for i in range(10):
    for i in range(4):
        turtle.forward(n)
        turtle.left(90)
    turtle.forward(n)
    turtle.penup()
    turtle.forward(n/4)
    turtle.right(90)
    turtle.forward(n/4)
    turtle.left(180)
    turtle.pendown()
    n*=1.5
time.sleep(5)
