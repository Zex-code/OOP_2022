import turtle
import time
turtle.tracer(2)
turtle.shape('turtle')

turtle.begin_fill()
turtle.color("yellow")
turtle.circle(90, 360)
turtle.end_fill()

turtle.penup()
turtle.goto(-30, 125)
turtle.pendown()
turtle.begin_fill()
turtle.color("blue")
turtle.circle(10, 360)
turtle.end_fill()

turtle.penup()
turtle.goto(30, 125)
turtle.pendown()
turtle.begin_fill()
turtle.color("blue")
turtle.circle(10, 360)
turtle.end_fill()

turtle.penup()
turtle.goto(0, 95)
turtle.pendown()
turtle.begin_fill()
turtle.color("black")
turtle.width(10)
turtle.goto(0, 60)
turtle.end_fill()

turtle.penup()
turtle.goto(50, 70)
turtle.pendown()
turtle.pencolor("red")
turtle.left(90)
turtle.circle(50, -180)

time.sleep(5)
